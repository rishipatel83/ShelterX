{
  "name": "shelterx-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "ShelterX Fullstack Workspace - Backend Thermal Simulation & Frontend Habitat Visualizer",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "node --watch backend/server.js",
    "test": "npm test --prefix backend",
    "check": "npm run check --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "import:data": "npm run import:data --prefix backend",
    "seed": "npm run seed --prefix backend"
  },
  "keywords": [
    "shelterx",
    "thermal",
    "simulation"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5"
  }
}
